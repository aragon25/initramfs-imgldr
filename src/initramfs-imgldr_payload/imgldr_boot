# Local filesystem mounting      -*- shell-script -*-

#
# This script overrides local_mount_root() in /scripts/local
# and mounts root as a read-only filesystem with a temporary (rw)
# overlay image filesystem.
#

. /scripts/local

export ROOT_MOUNT="false"
export BOOT_MOUNT="false"
export SQFS_MOUNT="false"

pretty_text() {
  printf '%s\n%s  %-30s  %s\n' "######################################" "##" "" "##"
  for i in "${@}"; do
    printf "%s  %-30s  %s\n" "##" "$i" "##"
  done
  printf '%s  %-30s  %s\n%s\n' "##" "" "##" "######################################"
}

shell_console() {
  if command -v setsid >/dev/null 2>&1; then
    read -r console rest </proc/consoles
    if [ "${console}" = "tty0" ]; then
      console="tty1"
    fi
    setsid sh -c "exec sh -i <>/dev/${console} 1>&0 2>&1"
  else
    sh -i </dev/console >/dev/console 2>&1
  fi
}

panic_pretty() {
  [ $# -ne 0 ] && pretty_text "${@}"
  local response="x"
  echo " "
  echo "What would you do?"
  echo "enter console? (c), reboot? (r), poweroff? (p)"
  while [ "${response}" != "c" ] && [ "${response}" != "r" ] && [ "${response}" != "p" ]; do
    read -n 1 -s response
  done
  if [ "$response" = "c" ]; then
    shell_console
  fi
  if [ "$response" = "r" ]; then
    echo "Reboot in 5 seconds..."
    sleep 5
    reboot -f
  fi
  if [ "$response" = "p" ]; then
    echo "Power off in 5 seconds..."
    sleep 5
    poweroff -f
  fi
}

local_mount_root()
{
  local_top
  if [ -z "${ROOT}" ]; then
    panic_pretty "     !!! KERNEL PANIC !!!" "  No root device specified." " Boot arguments must include" "      a root= parameter."
  fi
  local_device_setup "${ROOT}" "root file system"
  ROOT="${DEV}"
  local ROOT_DEV="${ROOT}"
  local BOOT_DEV="${ROOT%?}1"
  local mount_script="/usr/share/imgldr/mount"
  local postmount_script="/usr/share/imgldr/postmount"

  # Get the root filesystem type if not set
  if [ -z "${ROOTFSTYPE}" ] || [ "${ROOTFSTYPE}" = auto ]; then
    FSTYPE=$(get_fstype "${ROOT_DEV}")
  else
    FSTYPE=${ROOTFSTYPE}
  fi

  local_premount

  modprobe ${FSTYPE}
  checkfs ${ROOT} root "${FSTYPE}"

  # Create directories for mountpoints
  mkdir -p /mnt/tmproot /mnt/tmpboot /mnt/syssqfs

  # Mount rootfs to /mnt/tmproot
  if [ "${FSTYPE}" != "unknown" ]; then
    if mount -t ${FSTYPE} ${ROOT_DEV} /mnt/tmproot >/dev/null 2>&1; then
      ROOT_MOUNT="/mnt/tmproot"
    else
      panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" "      root file system!" "${ROOT_DEV}"
    fi
  else
    if mount ${ROOT_DEV} /mnt/tmproot >/dev/null 2>&1; then
      ROOT_MOUNT="/mnt/tmproot"
    else
      panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" "      root file system!" "${ROOT_DEV}"
    fi
  fi

  # Mount bootfs to /mnt/tmpboot
  if mount ${BOOT_DEV} /mnt/tmpboot >/dev/null 2>&1; then
    BOOT_MOUNT="/mnt/tmpboot"
  else
    panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" "      boot file system!" "${BOOT_DEV}"
  fi

  # Mount system.sqfs image
  if mount -t squashfs /mnt/tmproot/IMAGES/system.sqfs /mnt/syssqfs; then
    SQFS_MOUNT="/mnt/syssqfs"
  else
    panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" " {ROOT_DEV}/IMAGES/system.sqfs" "     as root file system."
  fi

  # Check overlay module
  if ! modprobe overlay; then
    local overlay_mod="/mnt/syssqfs/SYSTEM/lib/modules/$(uname -r)/kernel/fs/overlayfs/overlay.ko"
    [ -f "${overlay_mod}" ] && insmod "${overlay_mod}"
  fi
  if ! modprobe overlay; then
    panic_pretty "     !!! KERNEL PANIC !!!" "    Failed to load overlay" "        kernel module"
  fi

  # Mount the final root overlay filesystem at ${rootmnt}
  if [ -f "$mount_script" ]; then
    /bin/sh -c "$mount_script"
    if [ $? -ne 0 ]; then
      echo "... WARNING: IMGLDR MOUNT SCRIPT FAILED ..."
    fi
  else
    panic_pretty "     !!! KERNEL PANIC !!!" "    Failed to find IMGLDR" "        mount script!" "     Cannot mount rootfs!"
  fi

  # Run postmount script if it exists
  if [ -f "$postmount_script" ]; then
    /bin/sh -c "$postmount_script"
    if [ $? -ne 0 ]; then
      echo "... WARNING: IMGLDR POSTMOUNT SCRIPT FAILED ..."
    fi
  fi
}
