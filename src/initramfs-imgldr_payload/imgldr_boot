# Local filesystem mounting      -*- shell-script -*-

#
# This script overrides local_mount_root() in /scripts/local
# and mounts root as a read-only filesystem with a temporary (rw)
# overlay image filesystem.
#

. /scripts/local

if [ -f /scripts/imgldr_vars ]; then
  . /scripts/imgldr_vars
else
  echo "... ERROR: IMGLDR FAILED TO LOAD FUNCTIONS ..."
  if command -v setsid >/dev/null 2>&1; then
    read -r console rest </proc/consoles
    if [ "${console}" = "tty0" ]; then
      console="tty1"
    fi
    setsid sh -c "exec sh -i <>/dev/${console} 1>&0 2>&1"
  else
    sh -i </dev/console >/dev/console 2>&1
  fi
fi

local_mount_root()
{
  local_top
  if [ -z "${ROOT}" ]; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "  No root device specified." " Boot arguments must include" "      a root= parameter."
  fi
  local_device_setup "${ROOT}" "root file system"
  ROOT="${DEV}"
  local root_dev="${ROOT}"
  local boot_dev="${ROOT%?}1"
  local mount_script="/usr/share/imgldr/mount"
  local postmount_script="/usr/share/imgldr/postmount"

  # Get the root filesystem type if not set
  if [ -z "${ROOTFSTYPE}" ] || [ "${ROOTFSTYPE}" = auto ]; then
    FSTYPE=$(get_fstype "${root_dev}")
  else
    FSTYPE=${ROOTFSTYPE}
  fi

  local_premount

  # Check needed modules
  if ! modprobe overlay; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "   Failed to load overlayfs" "        kernel module"
  fi
  if ! modprobe squashfs; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "    Failed to load squashfs" "        kernel module"
  fi
  if ! modprobe ${FSTYPE}; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "    Failed to load ${FSTYPE}" "        kernel module"
  fi
  checkfs ${ROOT} root "${FSTYPE}"

  # Create directories for mountpoints
  mkdir -p /mnt/tmproot /mnt/tmpboot /mnt/syssqfs

  # Mount rootfs to /mnt/tmproot
  if [ "${FSTYPE}" != "unknown" ]; then
    if mount -t ${FSTYPE} ${root_dev} /mnt/tmproot >/dev/null 2>&1; then
      ROOT_MOUNT="/mnt/tmproot"
    else
      imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" "      root file system!" "${root_dev}"
    fi
  else
    if mount ${root_dev} /mnt/tmproot >/dev/null 2>&1; then
      ROOT_MOUNT="/mnt/tmproot"
    else
      imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" "      root file system!" "${root_dev}"
    fi
  fi

  # Mount bootfs to /mnt/tmpboot
  if mount ${boot_dev} /mnt/tmpboot >/dev/null 2>&1; then
    BOOT_MOUNT="/mnt/tmpboot"
  else
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" "      boot file system!" "${boot_dev}"
  fi

  # Mount system.sqfs image
  if mount -t squashfs ${ROOT_MOUNT}/IMAGES/system.sqfs /mnt/syssqfs; then
    SQFS_MOUNT="/mnt/syssqfs"
  else
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "       Failed to mount" " {root_dev}/IMAGES/system.sqfs" "     as root file system."
  fi

  # Mount the final root overlay filesystem at ${rootmnt}
  if [ -f "$mount_script" ]; then
    /bin/sh -c "$mount_script"
    if [ $? -ne 0 ]; then
      echo "... WARNING: IMGLDR MOUNT SCRIPT FAILED ..."
    fi
    [ -e /conf/param.conf ] && . /conf/param.conf
  else
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "    Failed to find IMGLDR" "        mount script!" "     Cannot mount rootfs!"
  fi

  # Run postmount script if it exists
  if [ -f "$postmount_script" ]; then
    /bin/sh -c "$postmount_script"
    if [ $? -ne 0 ]; then
      echo "... WARNING: IMGLDR POSTMOUNT SCRIPT FAILED ..."
    fi
    [ -e /conf/param.conf ] && . /conf/param.conf
  fi
}
