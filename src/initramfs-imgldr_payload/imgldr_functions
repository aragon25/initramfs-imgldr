imgldr_reload_vars() {
  [ -e /conf/param.conf ] && . /conf/param.conf
  imgldr_check_dev_mounts
}

imgldr_wait_for_udev() {
  command -v udevadm >/dev/null 2>&1 || return 0
  udevadm settle ${1:+--timeout=$1}
}

imgldr_get_devices() {
  [ "$ROOT_DEV" != "___ROOT_DEV___" ] && [ "$BOOT_DEV" != "___BOOT_DEV___" ] && return 0
  local root_cmdline="___ROOT_CMDLINE___"
  for x in $(cat /proc/cmdline)
  do
    case $x in
      root=*)
        root_cmdline=${x#root=}
      ;;
    esac
  done
  if [ "$root_cmdline" = "___ROOT_CMDLINE___" ]; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "  No root device specified." " Boot arguments must include" "      a root= parameter."
  fi
  imgldr_wait_for_udev 10
  n=0
  while [ "$n" -lt 10 ]; do
    case "$root_cmdline" in
      LABEL=* | UUID=* | PARTLABEL=* | PARTUUID=*)
        ROOT_DEV="$(blkid -l -t "$root_cmdline" -o device)" || ROOT_DEV="___ROOT_DEV___"
      ;;
    esac
    if [ "$ROOT_DEV" != "___ROOT_DEV___" ]; then
      BOOT_DEV="${ROOT_DEV%?}1"
      [ "$(blkid -o value -s TYPE $BOOT_DEV 2>/dev/null)" != "vfat" ] && BOOT_DEV="___BOOT_DEV___"
      break
    fi
    n=$((n+1))
    sleep 1.0
  done
  mkdir -p /conf
  touch /conf/param.conf
  echo "ROOT_DEV=$ROOT_DEV" >> "/conf/param.conf"
  echo "BOOT_DEV=$BOOT_DEV" >> "/conf/param.conf"
}

imgldr_pretty_text() {
  printf '%s\n%s  %-30s  %s\n' "######################################" "##" "" "##"
  for i in "${@}"; do
    printf "%s  %-30s  %s\n" "##" "$i" "##"
  done
  printf '%s  %-30s  %s\n%s\n' "##" "" "##" "######################################"
  sleep 2
}

imgldr_shell_console() {
  if command -v setsid >/dev/null 2>&1; then
    read -r console rest </proc/consoles
    if [ "${console}" = "tty0" ]; then
      console="tty1"
    fi
    setsid sh -c "exec sh -i <>/dev/${console} 1>&0 2>&1"
  else
    sh -i </dev/console >/dev/console 2>&1
  fi
  imgldr_do_reboot
}

imgldr_panic_pretty() {
  [ $# -ne 0 ] && imgldr_pretty_text "${@}"
  local response="x"
  echo " "
  echo "What would you do?"
  echo "enter console? (c), reboot? (r), poweroff? (p)"
  [ "${DEBUG_MODE}" = "true" ] && echo "DEBUGMODE option: continue boot? (b)"
  while [ "${response}" != "c" ] && [ "${response}" != "r" ] && [ "${response}" != "p" ] && 
        ( [ "${DEBUG_MODE}" = "false" ] || ( [ "${DEBUG_MODE}" = "true" ] && [ "${response}" != "b" ] ) ); do
    read -n 1 -s response
  done
  if [ "$response" = "c" ]; then
    imgldr_shell_console
  fi
  if [ "$response" = "r" ]; then
    imgldr_do_reboot
  fi
  if [ "$response" = "p" ]; then
    imgldr_do_poweroff
  fi
}

imgldr_check_dev_mounts() {
  imgldr_get_devices
  local mounts="$(mount)"
  if [ "$(echo "$mounts" | fgrep "${ROOT_DEV}" 2>/dev/null | wc -l)" = "0" ]; then 
    ROOT_MOUNT="false"
  else
    ROOT_MOUNT="$(findmnt -n -o TARGET "$ROOT_DEV" 2>/dev/null)"
  fi
  if [ "$(echo "$mounts" | fgrep "${BOOT_DEV}" 2>/dev/null | wc -l)" = "0" ]; then
    BOOT_MOUNT="false"
  else
    BOOT_MOUNT="$(findmnt -n -o TARGET "$BOOT_DEV" 2>/dev/null)"
  fi
  if [ "$(echo "$mounts" | fgrep squashfs 2>/dev/null | wc -l)" = "0" ] || [ "$(echo "$mounts" | fgrep /mnt/sys_sqfs 2>/dev/null | wc -l)" = "0" ]; then
    SQFS_MOUNT="false"
  else
    SQFS_MOUNT="/mnt/sys_sqfs"
  fi
}

imgldr_mount_fs() {
  imgldr_get_devices
  imgldr_check_dev_mounts
  if ( [ "$ROOT_MOUNT" != "/mnt/sys_rootfs" ] && [ "$ROOT_MOUNT" != "false" ] ) || 
     ( [ "$BOOT_MOUNT" != "/mnt/sys_bootfs" ] && [ "$BOOT_MOUNT" != "false" ] ); then
    imgldr_umount_fs
  fi
  if [ "$ROOT_DEV" != "___ROOT_DEV___" ]; then
    if [ "$ROOT_MOUNT" = "false" ]; then
      mkdir -p /mnt/sys_rootfs
      umount "/mnt/sys_rootfs" >/dev/null 2>&1
      mount -o rw,noatime "$ROOT_DEV" /mnt/sys_rootfs >/dev/null 2>&1
      imgldr_check_dev_mounts
      [ "$ROOT_MOUNT" = "false" ] && imgldr_panic_pretty "     !!! KERNEL PANIC !!!" " Failed to mount root device." "Check if the device exists and" " is a valid root filesystem." "${ROOT_DEV}"
    fi
    if [ "$SQFS_MOUNT" = "false" ]; then
      if [ -f "${ROOT_MOUNT}/IMAGES/system.sqfs" ] && modprobe squashfs; then
        mkdir -p /mnt/sys_sqfs
        umount "/mnt/sys_sqfs" >/dev/null 2>&1
        mount -t squashfs ${ROOT_MOUNT}/IMAGES/system.sqfs /mnt/sys_sqfs >/dev/null 2>&1
        imgldr_check_dev_mounts
        [ "$SQFS_MOUNT" = "false" ] && imgldr_panic_pretty "     !!! KERNEL PANIC !!!" " Failed to mount system.sqfs." " Corrupted system.sqfs image!" "   Cannot continue booting!"
      fi
    fi
  else
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" " Failed to find root device." "Check if the device exists and" " is a valid root filesystem." "${ROOT_DEV}"
  fi
  if [ "$BOOT_DEV" != "___BOOT_DEV___" ]; then
    if [ "$BOOT_MOUNT" = "false" ]; then 
      mkdir -p /mnt/sys_bootfs
      umount "/mnt/sys_bootfs" >/dev/null 2>&1
      mount -o rw $BOOT_DEV /mnt/sys_bootfs >/dev/null 2>&1
      imgldr_check_dev_mounts
      [ "$BOOT_MOUNT" = "false" ] && imgldr_panic_pretty "     !!! KERNEL PANIC !!!" " Failed to mount boot device." "Check if the device exists and" " is a valid boot filesystem." "${BOOT_DEV}"
    fi
  else
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" " Failed to find boot device." "Check if the device exists and" " is a valid boot filesystem." "${BOOT_DEV}"
  fi
}

imgldr_umount_sqfs() {
  local attempt
  local result=0
  sync >/dev/null 2>&1
  imgldr_check_dev_mounts
  attempt=1
  while [ "${SQFS_MOUNT}" != "false" ] && [ $attempt -le 30 ]; do
    umount "${SQFS_MOUNT}" >/dev/null 2>&1
    imgldr_check_dev_mounts
    [ "${SQFS_MOUNT}" != "false" ] && { sleep 1; attempt=$((attempt + 1)); }
  done
  [ "${SQFS_MOUNT}" != "false" ] && echo "Could not umount: ${SQFS_MOUNT}" && result=1
  return $result
}

imgldr_umount_fs() {
  imgldr_get_devices
  imgldr_umount_sqfs || return 1
  local attempt
  local result=0
  sync >/dev/null 2>&1
  imgldr_check_dev_mounts
  attempt=1
  while [ "${ROOT_MOUNT}" != "false" ] && [ $attempt -le 30 ]; do
    umount "${ROOT_DEV}" >/dev/null 2>&1
    imgldr_check_dev_mounts
    [ "${ROOT_MOUNT}" != "false" ] && { sleep 1; attempt=$((attempt + 1)); }
  done
  attempt=1
  while [ "${BOOT_MOUNT}" != "false" ] && [ $attempt -le 30 ]; do
    umount "${BOOT_DEV}" >/dev/null 2>&1
    imgldr_check_dev_mounts
    [ "${BOOT_MOUNT}" != "false" ] && { sleep 1; attempt=$((attempt + 1)); }
  done
  [ "${ROOT_MOUNT}" != "false" ] && echo "Could not umount: ${ROOT_MOUNT}" && result=1
  [ "${BOOT_MOUNT}" != "false" ] && echo "Could not umount: ${BOOT_MOUNT}" && result=1
  return $result
}

imgldr_check_fs() {
  if [ -z "${ROOT_MOUNT}" ] || [ "${ROOT_MOUNT}" = "false" ]; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "     rootfs partition is" "         not mounted!" "   Cannot continue booting!"
  fi
  if [ -z "${BOOT_MOUNT}" ] || [ "${BOOT_MOUNT}" = "false" ]; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "       boot partition is" "         not mounted!" "   Cannot continue booting!"
  fi
  if [ -z "${SQFS_MOUNT}" ] || [ "${SQFS_MOUNT}" = "false" ]; then
    imgldr_panic_pretty "     !!! KERNEL PANIC !!!" "       squashfs image is" "         not mounted!" "   Cannot continue booting!"
  fi
}

imgldr_do_poweroff() {
  imgldr_umount_fs
  echo "Powering off in 5 seconds..."
  sleep 5
  poweroff -f
}

imgldr_do_reboot() {
  imgldr_umount_fs
  echo "Rebooting in 5 seconds..."
  sleep 5
  reboot -f
}

ROOT_DEV="___ROOT_DEV___"
BOOT_DEV="___BOOT_DEV___"
ROOT_MOUNT="false"
BOOT_MOUNT="false"
SQFS_MOUNT="false"
imgldr_reload_vars
